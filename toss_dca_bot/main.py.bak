# =====================================================================
# FILE: main.py
# 목적: 토스 스마트 적립식(1배 / 1/2배) & 목표수익(1~1000%) 분할익절 봇 메인 오케스트레이터
# =====================================================================

import os
import sys
import asyncio
import logging
from datetime import datetime
from zoneinfo import ZoneInfo
from aiogram import Bot, Dispatcher
from aiogram.client.session.aiohttp import AiohttpSession
from dotenv import load_dotenv

from toss_api import TossApiClient
from dca_engine import DcaConfigManager, execute_stock_dca_step
from tg_controller import router, inject_dependencies

logging.getLogger("aiogram").setLevel(logging.CRITICAL)
logging.getLogger("aiohttp").setLevel(logging.CRITICAL)

KST_TZ = ZoneInfo("Asia/Seoul")
EST_TZ = ZoneInfo("America/New_York")

env_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), ".env")
load_dotenv(dotenv_path=env_path)

TOSS_CLIENT_ID = os.getenv("TOSS_CLIENT_ID")
TOSS_CLIENT_SECRET = os.getenv("TOSS_CLIENT_SECRET")
TELEGRAM_BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
_telegram_chat_id_str = os.getenv("TELEGRAM_CHAT_ID")

if not all([TOSS_CLIENT_ID, TOSS_CLIENT_SECRET, TELEGRAM_BOT_TOKEN, _telegram_chat_id_str]):
    print("🚨 치명적 에러: .env 필수 환경변수가 누락되었습니다.", flush=True)
    sys.exit(1)

ADMIN_CHAT_ID = int(_telegram_chat_id_str)


async def daily_dca_scheduler_loop(client: TossApiClient, bot: Bot, chat_id: int):
    """
    평소에는 API를 호출하지 않고 로컬 시계만 20초 주기로 체크하다가,
    지정된 실행 시각(한국 KR KST / 미국 US EST)이 되면 하루 1회 각 종목의 적립/익절을 수행합니다.
    (기존 SOXS 스나이퍼 봇과 함께 돌려도 API 호출 충돌이 없도록 설계됨)
    """
    while True:
        try:
            cfg = await DcaConfigManager.load()
            if not cfg.get("is_master_active", True):
                await asyncio.sleep(20.0)
                continue

            kr_target_hm = cfg.get("kr_exec_time", "10:00")
            us_target_hm = cfg.get("us_exec_time", "10:00")

            now_kst = datetime.now(KST_TZ)
            now_est = datetime.now(EST_TZ)

            kst_hm = now_kst.strftime("%H:%M")
            est_hm = now_est.strftime("%H:%M")
            kst_date = now_kst.strftime("%Y-%m-%d")
            est_date = now_est.strftime("%Y-%m-%d")

            stocks = cfg.get("stocks", {})
            for sym, st in list(stocks.items()):
                if not st.get("enabled", True):
                    continue
                mc = st.get("market_country", "US")
                last_date = st.get("last_exec_date", "")

                if mc == "KR" and now_kst.weekday() < 5:
                    if kst_hm == kr_target_hm and last_date != kst_date:
                        await execute_stock_dca_step(client, bot, chat_id, sym, force_manual=False)
                elif mc == "US" and now_est.weekday() < 5:
                    if est_hm == us_target_hm and last_date != est_date:
                        await execute_stock_dca_step(client, bot, chat_id, sym, force_manual=False)

        except Exception as e:
            print(f"🚨 [스케줄러 루프 방어] {e}", flush=True)

        await asyncio.sleep(20.0)


async def main():
    session = AiohttpSession(timeout=10.0)
    bot = Bot(token=TELEGRAM_BOT_TOKEN, session=session)
    dp = Dispatcher()

    api_client = TossApiClient(client_id=TOSS_CLIENT_ID, client_secret=TOSS_CLIENT_SECRET)
    try:
        await api_client.fetch_account_seq()
    except Exception as e:
        print(f"🚨 [초기 기동] 계좌 번호 조회 지연(실행 시 재시도): {e}", flush=True)

    inject_dependencies(api_client, ADMIN_CHAT_ID)
    dp.include_router(router)

    asyncio.create_task(daily_dca_scheduler_loop(api_client, bot, ADMIN_CHAT_ID))

    print("✅ 토스 스마트 적립(1배/1/2배) & 분할익절 봇 기동 완료!", flush=True)

    try:
        await bot.delete_webhook(drop_pending_updates=True)
        await bot.send_message(
            chat_id=ADMIN_CHAT_ID,
            text=(
                "✅ <b>[토스 스마트 적립 & 분할익절 봇 기동 완료]</b>\n"
                "▫️ <b>평단 이하</b>: 1회 기준 금액 <b>100% 매수</b>\n"
                "▫️ <b>평단 상회</b>: 1회 기준 금액의 <b>1/2(절반) 매수</b>\n"
                "▫️ <b>목표 수익률(1~1000%) 도달</b>: 설정 비율(<b>1~100%</b>) 익절 매도 & <b>이후 날짜 매수 자동 중지</b>\n"
                "▫️ <b>주문 방식</b>: 🇺🇸 미국주식 소수점 주문 / 🇰🇷 한국주식 1주 단위 주문\n\n"
                "👉 <code>/start</code> 또는 <code>/panel</code> 을 눌러 종목과 금액·퍼센트를 설정하세요!"
            ),
            parse_mode="HTML",
        )
    except Exception:
        pass

    while True:
        try:
            await dp.start_polling(bot)
        except Exception as e:
            print(f"🚨 [폴링 재연결 대기] 5초 후 재시도: {e}", flush=True)
            await asyncio.sleep(5.0)
        else:
            break


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except (KeyboardInterrupt, SystemExit):
        pass
