# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요.   cp .env.example .env
# .env 는 비밀번호와 같습니다. GitHub에 올리지 말고, 채팅창에도 붙여넣지 마세요.
# (주석은 줄 맨 앞에만 쓸 수 있습니다. 값 뒤에 # 주석을 붙이지 마세요.)

# ── 필수 ─────────────────────────────────────────────
# 비서봇 토큰 (BotFather에서 받은 것). 허브가 이 봇으로 메시지를 보냅니다.
TELEGRAM_BOT_TOKEN=
# 알림을 받을 내 채팅 ID (숫자)
TELEGRAM_CHAT_ID=

# ── 감시할 봇 목록 ───────────────────────────────────
# 쉼표로 구분. "이름:분" 으로 그 봇만 무소식 기준을 따로 줄 수 있어요.
# 아래 예: 업데이트봇은 하루 한 번만 도니까 1500분(25시간)
HUB_BOT_NAMES=매매봇1,매매봇2,매매봇3,매매봇4,매매봇5,업데이트봇:1500
# 기본 무소식 기준(분). 이 시간 동안 하트비트가 없으면 긴급 알림
HUB_STALE_MINUTES=180

# ── 선택 ─────────────────────────────────────────────
# 기록 DB 위치. 비워두면 프로젝트 폴더/data/hub.db
HUB_DB_PATH=
# 브리핑 시간 표시 기준
HUB_TZ=Asia/Seoul

# AI 요약을 쓰려면 Claude API 키를 넣으세요. 비워두면 숫자 브리핑만 나갑니다.
ANTHROPIC_API_KEY=
# 비용을 아끼려면 claude-haiku-5-5
HUB_AI_MODEL=claude-sonnet-5-5

# 같은 긴급 알림 반복 억제(분) / 10분당 봇 1개가 보낼 수 있는 긴급 알림 최대 건수
HUB_DEDUP_MINUTES=10
HUB_FLOOD_LIMIT=5
# 같은 봇 무소식 경고를 다시 알려주는 간격(시간)
HUB_REMIND_HOURS=6
# 기록 보관 일수
HUB_KEEP_DAYS=30
# 1 이면 전송이 끝날 때까지 기다림(디버깅용). 평소엔 0 (백그라운드 전송)
HUB_SYNC=0
