[Unit]
Description=Toss Smart DCA & Partial Take-Profit Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gieokkim
WorkingDirectory=/home/gieokkim/toss_dca_bot
ExecStart=/home/gieokkim/toss_sniper/venv/bin/python /home/gieokkim/toss_dca_bot/main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
