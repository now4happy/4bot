[Unit]
Description=Mount unit for google-cloud-cli, revision 503
After=snapd.mounts-pre.target
Before=snapd.mounts.target

[Mount]
What=/var/lib/snapd/snaps/google-cloud-cli_503.snap
Where=/snap/google-cloud-cli/503
Type=squashfs
Options=nodev,ro,x-gdu.hide,x-gvfs-hide
LazyUnmount=yes

[Install]
WantedBy=snapd.mounts.target
WantedBy=multi-user.target
